# Copy this file to .env and fill in your own key. The .env file is gitignored.
OPENAI_API_KEY=sk-your-key-here

# Models: terra is the balanced default, luna is the cheap tier for bulk evaluation.
CLAIMLOOP_MODEL_MAIN=gpt-5.6-terra
CLAIMLOOP_MODEL_CHEAP=gpt-5.6-luna

# Reasoning effort for the agents: none, low, medium, high
CLAIMLOOP_REASONING_EFFORT=medium

# Fixed service date so runs are reproducible
CLAIMLOOP_SERVICE_DATE=2026-05-15

# Which ACI-Bench splits the backend serves as sample encounters
CLAIMLOOP_SPLITS=valid,test1
